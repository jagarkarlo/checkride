---
import ProductLayout from '../layouts/ProductLayout.astro';
import Shot from '../components/Shot.astro';

const description = 'Nostekon runs restore drills and reports whether the application and its data actually came back: how deep recovery went, how long it took and how many acknowledged writes were lost.';

const install = `git clone https://github.com/jagarkarlo/nostekon.git
cd nostekon
python3 -m venv .venv
. .venv/bin/activate
pip install -e ".[dev]"
nostekon validate examples/drills/mlflow-namespace-loss.yaml`;

const lab = `make lab-up
python3 scripts/lab/restore.py --output /tmp/drill.json
make lab-down`;

const key = `install -d -m 700 "$HOME/.config/nostekon"
go run ./cmd/nostekon-attest keygen \\
  --private "$HOME/.config/nostekon/signing-key.pem" \\
  --public "$HOME/.config/nostekon/trusted-key.pem"`;

const report = `go run ./cmd/nostekon-report /tmp/drill.json
attestation_dir=$(mktemp -d)
attestation="$attestation_dir/run.attestation.json"
go run ./cmd/nostekon-attest sign \\
  --evidence /tmp/drill.json \\
  --key "$HOME/.config/nostekon/signing-key.pem" \\
  --output "$attestation"
go run ./cmd/nostekon-report \\
  --attestation "$attestation" \\
  --trusted-key "$HOME/.config/nostekon/trusted-key.pem" \\
  /tmp/drill.json
rm -r "$attestation_dir"`;

const steps = [
  { title: "Describe the drill", text: "A YAML file names the failure to simulate, where to restore, how deep to verify and your recovery time and data loss goals.", state: "Available", later: false },
  { title: "Run the restore", text: "The lab runner backs up a seeded PostgreSQL database, deletes the source namespace and restores into a second k3d cluster. Restoring real applications is not built yet.", state: "Lab only", later: true },
  { title: "Record what happened", text: "Check results, phase timings and, optionally, a ledger of acknowledged writes go into one DrillRun JSON file.", state: "Available", later: false },
  { title: "Evaluate the evidence", text: "A Go program turns the file into a report. Its exit code lets a CI job fail on a bad drill.", state: "Available", later: false },
  { title: "Sign the evidence", text: "An Ed25519 signature ties the exact file to a key you trust, so later edits are detectable.", state: "Available", later: false },
];
---
<ProductLayout title="Find out whether a restore really worked" description={description} current="overview">
  <section class="hero">
    <div class="wrap">
      <h1>Find out whether a restore really worked</h1>
      <p class="lead">A finished backup job tells you a file was written. It does not tell you the application came back with its data. Nostekon runs a restore drill, records what happened, and reports how far recovery got, how long it took and how many acknowledged writes were lost.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/demo/index.html#/report">Open the demo</a>
        <a class="btn" href="/docs/">Read the docs</a>
      </div>
      <p class="hero-note">Pre-alpha. Today it runs one disposable PostgreSQL restore on two local k3d clusters and evaluates the evidence. The demo runs in your browser and never contacts a cluster.</p>
    </div>
  </section>

  <section class="wrap" aria-label="Screenshot">
    <Shot name="report-lab" alt="Nostekon Studio report for a recorded lab run: verified to V3, recovery time 16 seconds, with a per-level breakdown and a recovery timeline." caption="A recorded run from the two-cluster lab, opened in Studio. It reached V3. It has no write ledger, and its signature is unverified." />
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>What a report tells you</h2>
        <p class="section-lead">One verdict, and the reasons behind it.</p>
      </div>
      <dl class="facts">
        <div>
          <dt>How deep recovery went</dt>
          <dd>Five levels, from "the backup job succeeded" to "the data is correct". The report names the deepest level that passed in order, and the first check that failed.</dd>
        </div>
        <div>
          <dt>How long it took</dt>
          <dd>Recovery time runs from the moment of failure to completion, split into phases, with any time no phase accounts for shown separately.</dd>
        </div>
        <div>
          <dt>How much data was lost</dt>
          <dd>If you record acknowledged writes, Nostekon compares them with what came back and reports the loss window and any gaps in the sequence.</dd>
        </div>
        <div>
          <dt>What it cannot tell you</dt>
          <dd>A report judges the evidence it is given. A signature shows the file was not changed afterwards. It does not show the runner told the truth. <a class="link" href="/evidence/">More on the evidence model</a>.</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>How a drill runs</h2>
        <p class="section-lead">The whole flow, with what exists today marked.</p>
      </div>
      <ol class="steps">
        {steps.map((step) => (
          <li class="step">
            <h3>{step.title}</h3>
            <span class:list={["step-state", "pipeline-state", { later: step.later }]}>{step.state}</span>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="quickstart">
    <div class="wrap">
      <div class="section-head">
        <h2>Try it on your machine</h2>
        <p class="section-lead">The repository is private for now, so step one needs an account with access.</p>
      </div>
      <div class="code-grid">
        <div class="code-card quickstart-step">
          <h3>1. Clone and validate a drill</h3>
          <p>This checks the drill file against the contract. It does not run a restore. Nostekon is not on PyPI yet, so install it from the clone.</p>
          <div class="code-block">
            <div class="code-head"><span>Shell</span><button class="copy" type="button" data-copy-target="quickstart-install" data-copy-label="Copy CLI setup commands" aria-label="Copy CLI setup commands">Copy</button></div>
            <pre><code id="quickstart-install">{install}</code></pre>
          </div>
        </div>
        <div class="code-card quickstart-step">
          <h3>2. Run the lab restore</h3>
          <p>Needs Docker, k3d, kubectl, Python 3.12+ and Go. Use only the dedicated lab clusters. The run deletes its own source namespace.</p>
          <div class="code-block">
            <div class="code-head"><span>Shell</span><button class="copy" type="button" data-copy-target="quickstart-lab" data-copy-label="Copy lab commands" aria-label="Copy lab commands">Copy</button></div>
            <pre><code id="quickstart-lab">{lab}</code></pre>
          </div>
        </div>
        <div class="code-card quickstart-step">
          <h3>3. Read and sign the result</h3>
          <p>Create a signing key once, then sign and verify each run.</p>
          <div class="code-block">
            <div class="code-head"><span>Once</span><button class="copy" type="button" data-copy-target="quickstart-key" data-copy-label="Copy key setup commands" aria-label="Copy key setup commands">Copy</button></div>
            <pre><code id="quickstart-key">{key}</code></pre>
          </div>
          <div class="code-block">
            <div class="code-head"><span>Each run</span><button class="copy" type="button" data-copy-target="quickstart-report" data-copy-label="Copy report commands" aria-label="Copy report commands">Copy</button></div>
            <pre><code id="quickstart-report">{report}</code></pre>
          </div>
          <p class="code-note">Keep the private key out of the repository, and never run key setup over an existing key.</p>
        </div>
      </div>
      <p class="prose" style="margin-top: 24px;">Prefer not to install anything? <a class="link" href="/demo/index.html#/report">Open the demo</a>. The demo evaluates evidence; it does not connect to Kubernetes. Or <a class="link" href="/docs/start/">follow the CLI setup</a> and the <a class="link" href="/docs/guides/k3d-isolated-restore/">lab walkthrough</a> in the docs.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Where it stands</h2>
      </div>
      <div class="split">
        <div>
          <h3>Works today</h3>
          <ul class="ticks">
            <li>Validate drill files from the CLI, the API or Studio</li>
            <li>Run one PostgreSQL restore across two local k3d clusters, checked to V3</li>
            <li>Evaluate evidence: level reached, recovery time by phase, exact data loss from a write ledger</li>
            <li>Sign evidence and verify the signature from the command line</li>
            <li>Push recovery metrics to Prometheus and chart them on a bundled Grafana dashboard</li>
          </ul>
        </div>
        <div>
          <h3>Not built yet</h3>
          <ul class="ticks todo">
            <li>Scheduled drills</li>
            <li>Restoring real applications rather than a seeded table</li>
            <li>Application-specific correctness checks at V4</li>
            <li>Collecting evidence from the system itself instead of trusting the runner</li>
            <li>Signature verification in the static browser demo</li>
          </ul>
        </div>
      </div>
      <div class="prose" style="margin-top: 36px;">
        <p>Nostekon does not orchestrate backups and does not replace a backup tool. It exercises the restore you already have and reports whether it actually worked. See the <a class="link" href="/docs/comparison/">alternatives page</a> for how that differs from a sandbox restore or a health check, and the <a class="link" href="/roadmap/">roadmap</a> for what comes next.</p>
      </div>

    </div>
  </section>
</ProductLayout>

<script>
  document.addEventListener("click", async (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest<HTMLButtonElement>("[data-copy-target]");
    if (!button) return;
    const target = document.getElementById(button.dataset.copyTarget ?? "");
    if (!target) return;
    const label = button.dataset.copyLabel ?? "Copy";
    try {
      await navigator.clipboard.writeText(target.textContent?.trim() ?? "");
      button.textContent = "Copied";
      button.setAttribute("aria-label", "Commands copied");
    } catch {
      button.textContent = "Copy failed";
      button.setAttribute("aria-label", "Clipboard unavailable");
    }
    window.setTimeout(() => {
      button.textContent = "Copy";
      button.setAttribute("aria-label", label);
    }, 1600);
  });
</script>
