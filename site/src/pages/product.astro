---
import ProductLayout from "../layouts/ProductLayout.astro";
const description = "Checkride's architecture and current boundaries: drill specification, evidence evaluator, API, Studio and a disposable isolated PostgreSQL lab restore.";
const layers = [
  { n: "01", name: "Describe the recovery", status: "AVAILABLE", title: "Drill specification", copy: "A versioned declaration of the failure scenario, target, separate-cluster restore intent, verification depth and RTO/RPO objectives.", detail: "YAML → strict validation → actionable field errors" },
  { n: "02", name: "Capture what happened", status: "FORMAT AVAILABLE", title: "DrillRun evidence", copy: "A recorded run carries completion time, recovery phases, individual verification checks and, when instrumented, acknowledged writes and restored IDs.", detail: "JSON schema · 16 MiB API limit · 200,000 writes" },
  { n: "03", name: "Evaluate the evidence", status: "AVAILABLE · LOCAL", title: "V0–V4 report", copy: "The evaluator calculates the deepest contiguous level passed, first failed check, end-to-end RTO, phase coverage and exact RPO from the acknowledged-write ledger.", detail: "Go API · standalone Go CLI · downloadable report" },
  { n: "04", name: "Run one lab path", status: "AVAILABLE · LAB", title: "Isolated PostgreSQL restore", copy: "A disposable runner deletes the source namespace after backup, restores to a separate k3d cluster, observes V0–V3 checks and cleans up. General-purpose orchestration and attestation remain planned.", detail: "Two k3d clusters · pg_dump · V0–V3" },
];
---
<ProductLayout title="Product" description={description} current="product">
  <section class="subhero"><div class="page-wrap"><p class="kicker"><span class="pulse-dot"></span> 02 / SYSTEM DESIGN</p><h1>Built around the evidence.<br /><span>Not the backup status.</span></h1><p>Checkride separates what you intend, what happened and what can actually be proven. The boundary matters: today's evaluator reads recorded evidence; it does not perform a restore.</p></div></section>
  <section class="architecture-band"><div class="page-wrap architecture-list">{layers.map((layer) => <article class="architecture-row"><div class="architecture-meta"><span>{layer.n}</span><span>{layer.status}</span></div><div class="architecture-copy"><p class="section-index">{layer.name}</p><h2>{layer.title}</h2><p>{layer.copy}</p><code>{layer.detail}</code></div><div class:list={["architecture-state", { available: layer.status.includes("AVAILABLE"), planned: layer.status === "PLANNED" }]}>{layer.status === "PLANNED" ? "IN DESIGN" : "READY"}</div></article>)}</div></section>
  <section class="separation-band"><div class="page-wrap separation-grid"><div><p class="section-index">RESTORE TARGET / DEFAULT</p><h2>Separate cluster.<br /><span>Honest failure surface.</span></h2></div><div><p>A namespace restore shares the source cluster's operators, CRDs, storage classes and secrets. That can hide exactly the dependencies lost in a real cluster failure. Checkride's design defaults to a separate cluster; the current validator warns when a drill chooses the weaker namespace-only option.</p><a class="under-link" href="/docs/">Read the architecture decisions <span>↗</span></a></div></div></section>
  <section class="connect-band"><div class="page-wrap connect-grid"><span>DRILL SPEC</span><i>→</i><span>RESTORE RUN</span><i>→</i><span>V0–V4 CHECKS</span><i>→</i><span>RTO / RPO REPORT</span></div></section>
</ProductLayout>
