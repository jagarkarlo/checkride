---
import { ClientRouter } from 'astro:transitions';
import '../styles/product.css';
import '../styles/light.css';

interface Props {
  title: string;
  description: string;
  current: string;
}

const { title, description, current } = Astro.props;
const navigation = [
  { href: "/", label: "Overview", id: "overview" },
  { href: "/product/", label: "Product", id: "product" },
  { href: "/evidence/", label: "Evidence", id: "evidence" },
  { href: "/demo/index.html", label: "Live demo", id: "demo" },
  { href: "/roadmap/", label: "Roadmap", id: "roadmap" },
  { href: "/docs/", label: "Docs", id: "docs" },
];
---
<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080a0d" />
    <meta name="description" content={description} />
    <title>{title} | Checkride</title>
    <script is:inline>
      try {
        const stored = localStorage.getItem('checkride-theme');
        document.documentElement.dataset.theme = stored || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      } catch {
        document.documentElement.dataset.theme = 'dark';
      }
      document.addEventListener('click', (event) => {
        if (!event.target.closest('[data-theme-toggle]')) return;
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('checkride-theme', next); } catch { /* storage unavailable */ }
        document.querySelector('[data-theme-toggle]')?.setAttribute('aria-label', `Switch to ${next === 'dark' ? 'light' : 'dark'} mode`);
      });
      document.addEventListener('astro:page-load', () => {
        document.querySelector('[data-theme-toggle]')?.setAttribute('aria-label', `Switch to ${document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'} mode`);
      });
    </script>
    <ClientRouter fallback="animate" />
    <style is:global>
      .hero-band::before {
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(90deg, #0b0e11 0%, rgb(11 14 17 / 94%) 32%, rgb(11 14 17 / 58%) 70%, rgb(11 14 17 / 74%) 100%),
          linear-gradient(0deg, #0b0e11 0%, transparent 38%),
          url('/images/studio-report.png');
        background-repeat: no-repeat;
        background-position: center, center, right 12% center;
        background-size: 100% 100%, 100% 100%, min(82vw, 1060px) auto;
        content: '';
        pointer-events: none;
      }
      .hero-wrap { z-index: 1; }
      @media (max-width: 650px) {
        .hero-band::before {
          background-image:
            linear-gradient(0deg, #0b0e11 0%, rgb(11 14 17 / 90%) 45%, rgb(11 14 17 / 60%) 100%),
            url('/images/studio-report.png');
          background-position: center, 62% 7%;
          background-size: 100% 100%, auto 310px;
        }
      }
    </style>
  </head>
  <body class="product-shell">
    <header class="masthead">
      <a class="product-wordmark" href="/" aria-label="Checkride home">
        <span class="product-mark" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>CHECKRIDE</span>
      </a>
      <nav aria-label="Main navigation">
        {navigation.map((item) => (
          <a class:list={["nav-link", { selected: current === item.id }]} href={item.href} aria-current={current === item.id ? "page" : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
      <div class="masthead-tools">
        <a class="github-link" href="https://github.com/jagarkarlo/checkride" target="_blank" rel="noopener noreferrer" title="View source on GitHub" aria-label="GitHub repository">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
        </a>
        <button class="theme-toggle" data-theme-toggle type="button" aria-label="Switch to light mode" title="Toggle color theme"><span aria-hidden="true" class="dark-icon">☀</span><span aria-hidden="true" class="light-icon">☾</span></button>
        <a class="masthead-action" href="/docs/start/">Quick start <span aria-hidden="true">→</span></a>
      </div>
    </header>
    <main id="main-content" transition:animate="fade">
      <slot />
    </main>
    <footer class="product-footer">
      <a class="footer-wordmark" href="/">CHECKRIDE <span>RECOVERY VERIFICATION</span></a>
      <p>Pre-alpha · Apache-2.0 · Disposable lab restore only</p>
      <div><a href="/docs/">Documentation</a><a href="/comparison/">Comparisons</a><a href="https://github.com/jagarkarlo/checkride">Source</a></div>
    </footer>
  </body>
</html>
