---
import { ClientRouter } from 'astro:transitions';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  current: string;
}

const { title, description, current } = Astro.props;
const navigation = [
  { href: "/", label: "Overview", id: "overview" },
  { href: "/product/", label: "Product", id: "product" },
  { href: "/evidence/", label: "Evidence", id: "evidence" },
  { href: "/demo/index.html", label: "Live demo", id: "demo" },
  { href: "/roadmap/", label: "Roadmap", id: "roadmap" },
  { href: "/docs/", label: "Docs", id: "docs" },
];
---
<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f1318" />
    <meta name="description" content={description} />
    <link rel="preload" href="/fonts/dm-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title} | Checkride</title>
    <script is:inline>
      const readThemePreference = () => {
        try {
          const stored = localStorage.getItem('checkride-theme');
          if (stored === 'light' || stored === 'dark') return stored;
        } catch {}
        return matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      };
      const applyThemePreference = (root = document.documentElement) => {
        const theme = readThemePreference();
        root.dataset.theme = theme;
        const themeColor = root.querySelector('meta[name="theme-color"]');
        if (themeColor) themeColor.content = theme === 'light' ? '#f6f7f9' : '#0f1318';
      };
      const updateThemeButton = () => {
        applyThemePreference();
        const theme = document.documentElement.dataset.theme;
        document.querySelector('[data-theme-toggle]')?.setAttribute('aria-label', `Switch to ${theme === 'dark' ? 'light' : 'dark'} mode`);
      };

      applyThemePreference();
      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element) || !event.target.closest('[data-theme-toggle]')) return;
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('checkride-theme', next); } catch { /* storage unavailable */ }
        document.querySelector('[data-theme-toggle]')?.setAttribute('aria-label', `Switch to ${next === 'dark' ? 'light' : 'dark'} mode`);
      });
      document.addEventListener('astro:before-swap', (event) => {
        applyThemePreference(event.newDocument.documentElement);
      });
      document.addEventListener('astro:after-swap', updateThemeButton);
      document.addEventListener('astro:page-load', updateThemeButton);
    </script>
    <ClientRouter />
  </head>
  <body>
    <header class="masthead">
      <div class="wrap">
        <a class="wordmark" href="/" aria-label="Checkride home"><span class="wordmark-mark" aria-hidden="true"></span>Checkride</a>
        <nav class="nav" aria-label="Main navigation">
          {navigation.map((item) => (
            <a href={item.href} aria-current={current === item.id ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
        <div class="masthead-tools">
          <a class="tool-link" href="https://github.com/jagarkarlo/checkride" aria-label="GitHub repository">GitHub</a>
          <button class="theme-toggle" data-theme-toggle type="button" aria-label="Switch to light mode" title="Switch color theme">
            <svg class="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          </button>
        </div>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap">
        <p>Checkride is pre-alpha software under the Apache-2.0 license.</p>
        <nav aria-label="Footer">
          <a href="/docs/">Documentation</a>
          <a href="/docs/comparison/">Alternatives</a>
          <a href="/roadmap/">Roadmap</a>
          <a href="https://github.com/jagarkarlo/checkride">Source</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
