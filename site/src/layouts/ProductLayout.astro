---
import { ClientRouter } from 'astro:transitions';
import nostekonMark from '../content/docs/assets/nostekon-mark.svg?url';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  current: string;
}

const { title, description, current } = Astro.props;
const navigation = [
  { href: "/", label: "Overview", id: "overview" },
  { href: "/product/", label: "Product", id: "product" },
  { href: "/evidence/", label: "Evidence", id: "evidence" },
  { href: "/demo/index.html", label: "Live demo", id: "demo" },
  { href: "/roadmap/", label: "Roadmap", id: "roadmap" },
  { href: "/docs/", label: "Docs", id: "docs" },
];
---
<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f1318" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={nostekonMark} />
    <link rel="preload" href="/fonts/dm-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title} | Nostekon</title>
    <script is:inline>
      const readThemePreference = () => {
        try {
          const stored = localStorage.getItem('checkride-theme');
          if (stored === 'light' || stored === 'dark') return stored;
        } catch {}
        return matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      };
      const applyThemePreference = (root = document.documentElement) => {
        const theme = readThemePreference();
        root.dataset.theme = theme;
        const themeColor = root.querySelector('meta[name="theme-color"]');
        if (themeColor) themeColor.content = theme === 'light' ? '#f6f7f9' : '#0f1318';
      };
      const renderThemeButton = (theme) => {
        const button = document.querySelector('[data-theme-toggle]');
        const label = `Switch to ${theme === 'dark' ? 'light' : 'dark'} mode`;
        button?.setAttribute('aria-label', label);
        button?.setAttribute('title', label);
        const icon = button?.querySelector('[data-theme-icon]');
        if (icon) icon.textContent = theme === 'dark' ? '☀️' : '🌙';
      };
      const updateThemeButton = () => {
        applyThemePreference();
        renderThemeButton(document.documentElement.dataset.theme);
      };

      applyThemePreference();
      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element) || !event.target.closest('[data-theme-toggle]')) return;
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('checkride-theme', next); } catch { /* storage unavailable */ }
        renderThemeButton(next);
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'light' ? '#f6f7f9' : '#0f1318');
      });
      document.addEventListener('astro:before-swap', (event) => {
        applyThemePreference(event.newDocument.documentElement);
      });
      document.addEventListener('astro:after-swap', updateThemeButton);
      document.addEventListener('astro:page-load', updateThemeButton);
    </script>
    <ClientRouter />
  </head>
  <body>
    <header class="masthead">
      <div class="wrap">
        <a class="wordmark" href="/" aria-label="Nostekon home"><img class="wordmark-mark" src={nostekonMark} width="28" height="28" alt="" />Nostekon</a>
        <nav class="nav" aria-label="Main navigation">
          {navigation.map((item) => (
            <a href={item.href} aria-current={current === item.id ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
        <div class="masthead-tools">
          <a class="tool-link" href="https://github.com/jagarkarlo/checkride" aria-label="GitHub repository">GitHub</a>
          <button class="theme-toggle" data-theme-toggle type="button" aria-label="Switch to light mode" title="Switch to light mode">
            <span data-theme-icon aria-hidden="true">☀️</span>
          </button>
        </div>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap">
        <p>Nostekon is pre-alpha software under the Apache-2.0 license.</p>
        <nav aria-label="Footer">
          <a href="/docs/">Documentation</a>
          <a href="/docs/comparison/">Alternatives</a>
          <a href="/roadmap/">Roadmap</a>
          <a href="https://github.com/jagarkarlo/checkride">Source</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
